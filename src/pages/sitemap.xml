<%
let langs = {
    'zh-cn': 'zh-Hans',
    'zh-hk': 'zh-Hant'
};
%><?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xhtml="http://www.w3.org/1999/xhtml" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd"><% for(let langCode in ROUTERS) { %><% let langRouters = ROUTERS[langCode] %><% for(let item in langRouters) { %><% if(langRouters[item].denyIndex) continue;%>
    <url>
        <loc>https://<%= DOMAIN + langRouters[item].url %></loc>
        <changefreq>daily</changefreq>
    </url><% } %><% } %>
</urlset>